# Inference4Free — OpenAI-compatible server configuration
#
# Copy this file to .env:   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════════════════════
#  NO LLM CREDENTIALS ARE EVER SET IN THIS FILE.
#
#  Every provider account is created PROCEDURALLY by the application itself:
#    • auto-signup bots create accounts with auto-generated mailboxes
#      (catch-all IMAP domain or mail.tm throwaways) and read the OTP
#      verification mails automatically — zero human steps;
#    • credentials are stored bot-side in the ./data volume
#      (data/deepseek_token, data/*_cookies.json, data/accounts.json);
#    • the refresher daemon renews them automatically (HTTP refresh →
#      browser re-login using the stored accounts → fresh signup).
#  Providers whose web apps have no signup flow (claude, grok, qwen, kimi,
#  mistral) simply stay dormant until one of their tokens happens to exist
#  in data/ — they never require manual .env setup.
# ═══════════════════════════════════════════════════════════════════════════

# Optional: provider allowlist (comma-separated). Empty = ALL enabled.
#   Valid names: deepseek, gemini, chatgpt, claude, grok, mistral, qwen,
#                kimi, copilot, perplexity, glm
#   Example — run only DeepSeek and ChatGPT:  I4F_PROVIDERS=

# Optional MANUAL overrides for dormant providers (leave empty for fully
# autonomous operation — the bot handles everything that has a signup flow):
#   CLAUDE_SESSION_KEY    sessionKey cookie from claude.ai
#   GROK_SSO              sso cookie from grok.com
#   MISTRAL_SESSION_TOKEN session_token cookie from chat.mistral.ai
#   QWEN_TOKEN            Bearer token from chat.qwen.ai
#   KIMI_TOKEN            token cookie from kimi.com
#   CHATGPT_ACCESS_TOKEN  access token from chatgpt.com
#   GEMINI_1PSID          __Secure-1PSID cookie from gemini.google.com
CLAUDE_SESSION_KEY=
GROK_SSO=
MISTRAL_SESSION_TOKEN=
QWEN_TOKEN=
KIMI_TOKEN=
CHATGPT_ACCESS_TOKEN=
GEMINI_1PSID=

# Full configuration reference (cookie jars, login credentials, proxy pool,
# refresher, self-heal): see the environment table in README.md.deepseek,chatgpt
# Disabled providers get no routes on /v1/models, no health probes and no
# credential-bot signup attempts. (Requires a server restart to apply.)
I4F_PROVIDERS=

# Optional: if set, clients MUST send this value as their API key
#   Authorization: Bearer <I4F_API_KEY>
# Leave empty to allow any/absent API key (token-only auth).
I4F_API_KEY=

# Optional: host port for the OpenAI-compatible server (container port is 8000)
I4F_PORT=8000

# Optional: custom model names exposed on /v1/models
I4F_MODEL_THINKER=deepseek-reasoner
I4F_MODEL_FAST=deepseek-chat
I4F_MODEL_SEARCH=deepseek-search

# Optional: limits advertised on /v1/models (agent tools read these to size
# context window and max output tokens). Defaults follow DeepSeek's documented
# values: 128K context, 64K max output in thinking mode, 32K otherwise.
# The DeepSeek web API does not expose per-model metadata, so adjust these if
# DeepSeek changes its limits.
I4F_CONTEXT_LENGTH=131072
I4F_MAX_OUTPUT_THINKING=65536
I4F_MAX_OUTPUT=32768

# ---------------------------------------------------------------------------
# z.ai / ChatGLM (glm) transport tuning — the bot handles the session itself
# (anonymous guest token minted + stored in data/glm_cookies.json). All
# optional; defaults are sane:
#   I4F_ZAI_BROWSER=false  -> never use the headless-chromium z.ai transport
#   I4F_ZAI_HEADLESS=false -> run chromium under Xvfb (recommended: Aliyun's
#     silent anti-bot check blocks headless sessions without rendering)
#   timeouts are seconds (start = browser boot, idle = SSE silence,
#   total = hard cap per request, busy = FIFO wait for the browser session;
#   tuned so a wedged request releases the session before clients time out)
I4F_ZAI_BROWSER=true
I4F_ZAI_HEADLESS=false
I4F_ZAI_START_TIMEOUT=90
I4F_ZAI_IDLE_TIMEOUT=60
I4F_ZAI_TOTAL_TIMEOUT=300
I4F_ZAI_BUSY_TIMEOUT=180
# Realistic prompt budget (tokens) for the z.ai web transport — the browser
# input silently stops answering between ~40k and ~100k characters.
I4F_ZAI_CONTEXT_LENGTH=10000
# Independent z.ai browser sessions (1 = serialized; 2-4 enable parallel
# streams — each extra session spawns one Chromium only when requests overlap):
I4F_ZAI_PARALLEL=1
# Seconds after which an idle z.ai browser page is recycled proactively
# (anonymous sessions expire server-side and would fail with retry):
I4F_ZAI_STALE_AFTER=600
# Output reservation (tokens) advertised for z.ai routes — the web
# transport has no upstream output cap, so a small reservation keeps
# most of the 10k-token context for the conversation (llmtrim budget).
I4F_ZAI_MAX_OUTPUT=2048


I4F_ZAI_MODELS_TTL=900
# connect-phase cap (seconds) for pooled HTTP proxies; dead free proxies are
# put on cooldown and the request retries direct
I4F_HTTP_CONNECT_TIMEOUT=6
# copilot: mint the anonymous identity with a real headless chromium on first
# use (synthetic cookies are rejected by the edge). Set false to skip.
I4F_COPILOT_HARVEST=true

# ---------------------------------------------------------------------------
# Self-maintenance (dsk/selfheal.py): background probes check that each
# enabled provider still answers; on upstream web-app changes (structural
# failures) the affected provider module is auto-patched with an LLM-proposed
# fix — validated in a subprocess first, rolled back on any failure, audit
# trail in data/selfheal/ (never touches your data volume credentials).
I4F_SELFHEAL=true
# Seconds between background probe cycles:
I4F_SELFHEAL_PROBE_TTL=600
# Consecutive structural failures before an auto-patch attempt:
I4F_SELFHEAL_TRIGGER=3
# Anti-flapping: minimum seconds between heal attempts of the same provider:
I4F_SELFHEAL_COOLDOWN=3600
I4F_SELFHEAL_MAX_ATTEMPTS=3
I4F_SELFHEAL_MAX_INCIDENTS=4
# Providers the healer must never patch (comma-separated; empty = all allowed):
I4F_SELFHEAL_EXCLUDE=
# Optional custom fixer LLM (any OpenAI-compatible endpoint), tried first:
I4F_SELFHEAL_FIXER_BASE_URL=
I4F_SELFHEAL_FIXER_API_KEY=
I4F_SELFHEAL_FIXER_MODELS=
# Legacy aliases (same effect as the key/models above):
# As a last resort the server asks itself for the patch (needs one healthy
# provider; Disable with I4F_SELFHEAL_LOCAL=false):
I4F_SELFHEAL_LOCAL=true

# ---------------------------------------------------------------------------
# Credential bot (dsk/refresher.py): THE ONLY credential source — it creates,
# stores and renews every account automatically. Renewal ladder:
#   Rung 1 (automatic): HTTP refresh of the bot-managed cookie jars in the
#     ./data volume (gemini_cookies.json, chatgpt_cookies.json,
#     deepseek_token ...).
#   Rung 2 (default ON): headless-Chromium re-login with the accounts the
#     signup rung previously created (data/accounts.json).
#   Rung 3 (default ON): account auto-signup — the bot CREATES new accounts
#     and BOOTSTRAPS enabled providers that have no credentials at all,
#     using an auto-generated address (catch-all IMAP domain or a mail.tm
#     throwaway mailbox) and reads the OTP from that mailbox automatically.
#     Google/OpenAI captcha or phone walls make gemini/chatgpt best effort.
I4F_REFRESHER=true
# Seconds between proactive refresh cycles (default 6h):
I4F_REFRESHER_TTL=21600
I4F_REFRESHER_COOLDOWN=1800
I4F_REFRESHER_MAX_RENEWS=6
# Providers the bot must never touch (comma-separated; empty = all):
I4F_REFRESHER_EXCLUDE=
# Rung 2: browser re-login (Chromium runs headless inside the container):
I4F_REFRESHER_LOGIN=true
I4F_REFRESHER_HEADLESS=true
# Rung 3: auto-signup with an AUTO-GENERATED e-mail (fully autonomous with
# zero mail configuration; gemini/chatgpt best effort due to captcha/phone
# walls):
#   I4F_MAIL_DOMAIN  your catch-all mail domain (random local parts under it;
#                    OTP is read via the IMAP mailbox below) — recommended.
#   (fallback) mail.tm public temp-mail, no configuration required.
I4F_REFRESHER_AUTOSIGNUP=true
# Egress for signup browsers: DeepSeek's CloudFront blocks many datacenter
# IPs, so point this at a working HTTP or SOCKS5 proxy (residential works
# best), e.g. socks5h://user:pass@host:1080. Empty = dynamic free-proxy
# pool -> direct, in that order. Tor is never used anywhere.
I4F_SIGNUP_PROXY=
# Rung for ANONYMOUS providers (no credential exists): Copilot refuses EU
# egresses, Perplexity authwalls datacenter IPs. The ladder drops the
# provider's sticky proxy assignment and draws a fresh exit, so the next
# request leaves from a new IP. List the providers this applies to.
I4F_EGRESS_ROTATE=copilot,perplexity
# Per-rung circuit breaker: after N consecutive failures of the same rung for
# the same provider, that rung cools down (expensive browser rungs stop
# burning the daily budget on a blocked egress).
I4F_BREAKER_N=3
I4F_BREAKER_COOLDOWN_S=1800
I4F_MAIL_AUTOGEN=true
I4F_MAIL_DOMAIN=
I4F_MAIL_IMAP_HOST=
I4F_MAIL_IMAP_PORT=993
I4F_MAIL_IMAP_USER=
I4F_MAIL_IMAP_PASS=
# OTP extraction tuning (defaults: mails from "deepseek" not older than 30
# minutes, first 6-digit number):
I4F_MAIL_OTP_SENDER=deepseek
I4F_MAIL_OTP_MAX_AGE=30
I4F_MAIL_OTP_REGEX=\b(\d{6})\b

# ---------------------------------------------------------------------------
# Dynamic model discovery (all enabled providers)
#
# How often (seconds) /v1/models is re-discovered from each provider's web
# session. Unknown models requested by clients trigger an on-demand re-check.
I4F_MODELS_TTL=300

# Optional: per-model fallback chain (JSON map). RAW ids are kept even when no
# provider currently serves them, so fallbacks survive provider downtime.
# Example: {"deepseek-chat": ["deepseek-reasoner"]}
I4F_FALLBACKS=
# Optional: comma-separated default fallbacks applied to every route, e.g.
#   deepseek-reasoner,deepseek-chat. DISABLED (empty) per operator request:
# requests fail with the provider's own error instead of degrading to
# another model. Set e.g. I4F_DEFAULT_FALLBACKS=glm-4.7 to re-enable.
I4F_DEFAULT_FALLBACKS=

# ---------------------------------------------------------------------------
# llmtrim (dsk/llmtrim.py) — ALWAYS ON. Request pipeline:
#   LLM CALL -> llmtrim -> proxy rotator -> LLM response
# Before a request enters the proxy layer the message list is measured
# against the route's context budget: stale history is dropped oldest-first
# (system + latest turns kept) and oversized messages are middle-out
# truncated, so every egress route carries the smallest sufficient payload
# (faster first byte, less per-IP rate-limit pressure). Disable only if you
# must send byte-exact history:
I4F_LLMTRIM=true

# ---------------------------------------------------------------------------
# Outbound proxy rotation (spread requests across exit IPs, soften per-IP
# rate limits). All providers' HTTP traffic goes through a randomly (or
# round-robin) chosen route; failures put a proxy on cooldown and traffic
# falls back to direct.
#
# ROTATION INCLUDES NO-PROXY: the direct route is a first-class rotation
# candidate, so every provider rotates across
#   no-proxy -> proxy1 -> proxy2 -> proxy3 -> ...
# (direct first for I4F_PROXY_MODE=round). Disable with I4F_PROXY_DIRECT=false.
I4F_PROXY_DIRECT=true

# FAST PROXIES ONLY: the health pass measures each proxy's response latency
# and only proxies answering inside this budget (milliseconds) receive
# traffic — slow exits are never used.
I4F_PROXY_MAX_LATENCY=800

# FULLY DYNAMIC mode: aggregate public free-proxy lists over the web
# (TheSpeedX, monosans, proxifly, proxyscrape, roosterkid, geonode),
# refreshed every I4F_PROXY_LIST_TTL seconds. The pool is randomly sampled
# down to I4F_PROXY_MAX_POOL so health checking stays fast on small boards.
I4F_PROXY_AUTO=false
I4F_PROXY_MAX_POOL=400
# Optional static proxies (always in the pool, no health listing needed):
#   I4F_PROXY   = one proxy URL (http://host:port or socks5://host:port)
#   I4F_PROXIES = comma-separated list of proxy URLs
I4F_PROXY=
I4F_PROXIES=
# Optional: override the built-in sources ("socks5=<url>" sets the scheme;
# URLs mentioning socks5/socks4 are auto-detected):
I4F_PROXY_SOURCES=
# Optional: extra list URL(s) fetched with the same TTL (plain text or JSON):
I4F_PROXY_LIST_URL=
I4F_PROXY_LIST_URLS=
I4F_PROXY_LIST_TTL=1800

# Health checking: background worker probes every pooled proxy and traffic
# only uses the ones that answer. Strongly recommended with free lists
# (typically only ~10% of them are alive at any moment).
I4F_PROXY_CHECK=false
I4F_PROXY_CHECK_URL=https://api.ipify.org?format=json
I4F_PROXY_CHECK_TTL=1800
I4F_PROXY_CHECK_TIMEOUT=4
I4F_PROXY_CHECK_CONCURRENCY=24
# Seconds ensure_pool() (CLI one-shots / signup ladder) waits for the warm-up
# health pass before falling back to the raw pool.
I4F_PROXY_ENSURE_TIMEOUT=30

# Rotation strategy: random (default) | round | single
I4F_PROXY_MODE=random
# Providers that always go DIRECT (e.g. when a proxy breaks its bot
# protection). Comma-separated subset of the enabled providers.
# (DeepSeek is account-limited, not IP-limited -> I4F_PROXY_EXCLUDE=deepseek
# is a sensible default when using public proxies).
I4F_PROXY_EXCLUDE=
# Seconds a failing proxy is skipped before being retried:
I4F_PROXY_COOLDOWN=120
# Per-provider assignment: each provider gets its own randomly chosen proxy
# (distinct from other providers' while the pool allows), re-randomized every
# I4F_PROXY_ROTATE_TTL seconds and immediately reassigned after a failure.
I4F_PROXY_ROTATE_TTL=300
# Sanity check from the host:
#   I4F_PROXY_AUTO=true I4F_PROXY_CHECK=true python -m dsk.proxies

# ---- Advanced tuning (defaults in code; uncomment to override) ----
# Bind host inside the container (compose maps ${I4F_PORT:-8000}:8000)
#I4F_HOST=0.0.0.0
# Router retry engine: attempts + exponential backoff base (seconds)
#I4F_MAX_RETRIES=2
#I4F_RETRY_BACKOFF=2.0
# Auto router health: a provider that fails a real request (auth wall,
# outage, first-token stall) is pushed to the back of the 'auto' chain for
# this many seconds; a provider that just served stays eligible for this
# many seconds even when its credential probe disagrees. 0 disables.
#I4F_AUTO_DEMOTE_S=300
#I4F_AUTO_PROVE_S=900
# Default fast route when a client sends an unknown model id
#I4F_MODEL_FAST=deepseek-chat
# LLM auto-patcher: candidate dir + custom OpenAI-compatible fixer endpoint
#I4F_SELFHEAL_DIR=
#I4F_SELFHEAL_FIXER_BASE_URL=
#I4F_SELFHEAL_FIXER_API_KEY=
#I4F_SELFHEAL_FIXER_MODELS=
# Gemini web push id (rarely needed; derived automatically when unset)
#I4F_GEMINI_PUSH_ID=
# Per-provider context/output overrides (pattern: I4F_<PROVIDER>_CONTEXT_LENGTH
# and I4F_<PROVIDER>_MAX_OUTPUT; providers: DEEPSEEK, GEMINI, CHATGPT, CLAUDE,
# GROK, MISTRAL, QWEN, KIMI, COPILOT, PERPLEXITY, GLM). Example:
#I4F_GLM_CONTEXT_LENGTH=10000
#I4F_GLM_MAX_OUTPUT=2048
